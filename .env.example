SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# 서버 전용 키 - 절대 클라이언트 코드/브라우저에 노출하지 말 것
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# DB 직접 접속용 (마이그레이션 자동 적용 등). 서버 전용, 절대 클라이언트에 노출하지 말 것.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# 토스페이먼츠 - 실제 운영 전 사장님 본인 발급 키로 교체 필요
TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxx
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxx
